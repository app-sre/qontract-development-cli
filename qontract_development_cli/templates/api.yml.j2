services:
  # qontract-api (FastAPI)
  qontract-api:
    container_name: qontract-api
    platform: {{ profile.settings.qontract_api_container_platform or env.settings.container_platform }}
    {% if profile.settings.qontract_api_build_image %}
    build:
      context: {{ profile.settings.qontract_reconcile_path.expanduser().absolute() }}
      dockerfile: {{ profile.settings.qontract_api_path.expanduser().absolute() }}/Dockerfile
      target: debug
    {% else %}
    image: {{ profile.settings.qontract_api_image }}
    {% endif %}

    ports:
    - 8080:8080
    - {{ profile.settings.qontract_api_debugger_port }}:5678  # debugpy port

    environment:
    - QAPI_START_MODE=api
    - QAPI_CACHE_BROKER_URL=redis://cache:6379/0
    {% if env.settings.run_opa %}
    - QAPI_OPA__HOST=http://opa:8181
    {% else %}
    - QAPI_OPA__ENABLED=false
    {% endif %}
    # Enable debugpy
    - DEBUGGER_ENABLED={% if profile.settings.debugger %}true{% else %}false{% endif %}
    # Hot reload for development
    - AUTO_RELOAD={{ '0' if headless else '1' }}

    volumes:
    - {{ profile.settings.qontract_api_path.expanduser().absolute() }}/app.sh:/opt/app-root/src/app.sh:z
    - {{ profile.settings.qontract_api_path.expanduser().absolute() }}/.env:/opt/app-root/src/.env:z
    - {{ profile.settings.qontract_api_path.expanduser().absolute() }}/qontract_api:/opt/app-root/src/qontract_api/qontract_api:z
    - {{ profile.settings.qontract_reconcile_path.expanduser().absolute() }}/qontract_utils/qontract_utils:/opt/app-root/src/qontract_utils/qontract_utils:z

    healthcheck:
      test: ["CMD", "/opt/app-root/bin/python", "-c", "import json, urllib.request; r = json.load(urllib.request.urlopen('http://127.0.0.1:8080/health/ready', timeout=2)); assert r['status'] == 'healthy'"]
      interval: 2s
      timeout: 3s
      retries: 30
      start_period: 10s
